# Lost Kingsland Admin V27 Content & LiveOps Studio
# Copy to .env. Admin runs as a separate service from gameplay.

# ---------------- Database ----------------
# Leave empty = SNAPSHOT read-only mode.
DATABASE_URL=

ADMIN_HOST=127.0.0.1
ADMIN_PORT=8787

# Enable only for controlled config CRUD, direct media, and purpose-built support workflows.
ADMIN_WRITE_ENABLED=true

# Convenience mode for the local Windows developer machine.
# When ADMIN_HOST is 127.0.0.1, this creates an automatic OWNER session with no token prompt.
# It is NOT enabled for remote bind unless ADMIN_ALLOW_REMOTE_NO_AUTH=true (not recommended).
ADMIN_LOCAL_OWNER_MODE=true
ADMIN_OWNER_NAME=Viet
ADMIN_ALLOW_REMOTE_NO_AUTH=false

# Only used when ADMIN_LOCAL_OWNER_MODE=false or when binding remotely.
ADMIN_TOKEN=your-admin-token
ADMIN_ACTOR=Viet
ADMIN_GAMEPLAY_CONFIG=LK-V4.0-P15-RC-001

# ---------------- Shared content artwork / gallery ----------------
# auto: use platform.media_assets when available, otherwise fallback to data/media.
# database: recommended V27 shared-media mode for Admin + Web + Bot.
# database: prefer shared PostgreSQL binary storage.
# filesystem: local compatibility fallback.
ADMIN_MEDIA_BACKEND=database
ADMIN_MEDIA_DIR=data/media
ADMIN_MAX_IMAGE_MB=10
ADMIN_MAX_IMAGE_DIMENSION=4096

# Optional only for filesystem mode / reverse proxy / CDN.
# Admin UI never asks users to paste an image URL.
MEDIA_PUBLIC_BASE_URL=
